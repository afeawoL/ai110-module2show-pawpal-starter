classDiagram
    %% Keep this file updated so it matches your final implementation.

    class Owner {
        +str name
        +int available_minutes
        +time day_start
        +time day_end
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(pet_name: str) None
        +get_pet(pet_name: str) Pet
        +filter_tasks(pet_name, completed, category, priority, due_on) list~tuple~
        +get_all_tasks() list~Task~
        +set_constraints(available_minutes: int, day_start: time, day_end: time) None
        +daily_budget() int
    }

    class Pet {
        +str name
        +str species
        +int age
        +str special_needs
        +list~Task~ tasks
        +add_task(task: Task) None
        +edit_task(task_id: str, **changes) None
        +remove_task(task_id: str) None
        +complete_task(task_id: str, on_date: date) Task
        +get_tasks(include_completed: bool) list~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +Priority priority
        +str category
        +str preferred_window
        +time fixed_time
        +str recurrence
        +date due_date
        +bool completed
        +date completed_on
        +str id
        +validate() None
        +is_due(on_date: date) bool
        +mark_complete(on_date: date) Task
        +update(**changes) None
        +sort_key() tuple
        +earliest_start() time
    }

    class Priority {
        <<enumeration>>
        HIGH
        MEDIUM
        LOW
    }

    class Scheduler {
        +Owner owner
        +generate_plan(plan_date: date) Plan
        +mark_task_complete(task_id: str, on_date: date) Task
        +rank_tasks(tasks: list~Task~) list~Task~
        +sort_by_time(tasks: list~Task~) list~Task~
        +fits(task: Task, time_remaining: int) bool
        +check_conflicts(on_date: date) list~str~
        +detect_conflicts(items: list~ScheduledItem~) list~str~
        +explain_decision(task: Task, outcome: Outcome, remaining: int) str
    }

    class ScheduledItem {
        +Task task
        +Pet pet
        +time start_time
        +time end_time
        +str reason
        +duration() int
        +overlaps(other: ScheduledItem) bool
        +starting_at(pet: Pet, task: Task, start: time, reason: str)$ ScheduledItem
        +span() str
    }

    class FreeTime {
        +list gaps
        +int remaining
        +find(minutes: int, window: str) int
        +reserve(start: int, minutes: int) None
    }

    class Outcome {
        <<enumeration>>
        SCHEDULED
        FIXED
        OUTSIDE_WINDOW
        NO_TIME
        NO_SLOT
        OUTSIDE_DAY
    }

    class Plan {
        +date date
        +list~ScheduledItem~ scheduled_items
        +list unscheduled_items
        +list~str~ warnings
        +total_time_used() int
        +time_remaining(available_minutes: int) int
        +add_scheduled(item: ScheduledItem) None
        +add_unscheduled(task: Task, reason: str) None
        +summary() str
    }

    Owner "1" o-- "*" Pet : has
    Pet "1" *-- "*" Task : has
    Task --> Priority : uses
    Task ..> Task : mark_complete creates next occurrence
    Scheduler --> Owner : reads from
    Scheduler ..> Plan : creates
    Scheduler ..> FreeTime : tracks gaps with
    Scheduler ..> Outcome : explains with
    Plan "1" *-- "*" ScheduledItem : contains
    ScheduledItem --> Task : refers to
    ScheduledItem --> Pet : refers to
